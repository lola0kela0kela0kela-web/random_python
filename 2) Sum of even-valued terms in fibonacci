"""2) By considering the terms in the Fibonacci sequence whose values do not exceed four million,
find the sum of the even-valued terms."""

fibonacci = [0, 1]
order_1 = 0
order_2 = 1
while True:
    if fibonacci[-1] <= 4000000:
        fibonacci.append(fibonacci[order_1] + fibonacci[order_2])
        order_1 += 1
        order_2 += 1

    else:
        break

sum_fibonacci = 0

for i in fibonacci:
    if i % 2 == 0:
        sum_fibonacci = sum_fibonacci + i

print(sum_fibonacci)
