"""8) Viết một chương trình chấp nhận đầu vào là một câu,
 đếm số chữ cái và chữ số trong câu đó. Giả sử đầu vào
 sau được cấp cho chương trình: hello world! 123

Thì đầu ra sẽ là:

Số chữ cái là: 10
Số chữ số là: 3"""

đầu_vào = input("Nhập vô đầu vào: ")
letters = 0
digits = 0
for char in đầu_vào:
    if char.isalpha() == True:
        letters += 1

for char in đầu_vào:
    if char.isnumeric() == True:
        digits += 1

print(f"Số chữ cái là: {letters}")
print(f"Số chữ số là: {digits}")

