"""12) Viết chương trình tính số tiền thực của một tài khoản ngân hàng dựa
 trên nhật ký giao dịch được nhập vào từ giao diện điều khiển.

 Định dạng nhật ký như sau:
 D 100
W 200

(D là tiền gửi, W là tiền rút ra).

Giả sử đầu vào được cung cấp là:

D 300
D 300
W 200
D 100
Thì đầu ra sẽ là: 500"""

số_tiền_D = []
số_tiền_W = []
tiền_tổng = 0

while True:
    hỏi_user = input("Nhập vô: ")
    if hỏi_user == "":
        break

    hỏi_user = hỏi_user.split(" ")
    if hỏi_user[0].upper() == 'W':
        số_tiền_W.append(hỏi_user[1])
    elif hỏi_user[0].upper() == 'D':
        số_tiền_D.append(hỏi_user[1])

for i in số_tiền_D:
    i = int(i)
    tiền_tổng = tiền_tổng + i

for i in số_tiền_W:
    i = int(i)
    tiền_tổng = tiền_tổng - i

print(tiền_tổng)

