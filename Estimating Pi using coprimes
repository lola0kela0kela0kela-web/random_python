import random
import math

x = 0
y = 0
coprime_count = 0

for i in range(0, 10000):
    x = random.randint(1, 1000000)
    y = random.randint(1, 1000000)
    if math.gcd(x, y) == 1:
        coprime_count += 1

print(f"Coprime count: {coprime_count}")
probability = coprime_count / 10000

pi_estimate = math.sqrt(6 / probability)
print(f"Estimate of pi: {pi_estimate}")
