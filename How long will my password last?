"""Assuming that 1,000,000,000 guesses can be make per second
N = number of possible characters
L = length
Number of possible combinations = N ** L
Time in seconds to crack a password = Number of combinations / Number of guesses per second"""
import string

password = input("Enter your password: ")

n = 0

if any(c.islower() for c in password):
    n += 26
if any(c.isupper() for c in password):
    n += 26
if any(c.isdigit() for c in password):
    n += 10
if any(c in string.punctuation for c in password):
    n += 32

possible_combinations = n ** len(password)
print("Possible combinations", possible_combinations)
seconds = possible_combinations / 1000000000

def formatTime(seconds):

    if seconds < 0.001:
        return "a few milliseconds"

    if seconds < 60:
        return str(int(seconds)) + " seconds"

    minutes = seconds / 60
    if minutes < 60:
        return str(int(minutes)) + " minutes"

    hours = minutes / 60
    if hours < 24:
        return str(int(hours)) + " hours"

    days = hours / 24
    if days < 365:
        return str(int(days)) + " days"

    months = days / 30
    if months<12:
        return str(int(months)) + " months"

    years = days / 365
    return str(int(years)) + " years"

print("Estimated cracking time: " + formatTime(seconds))
